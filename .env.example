# ==============================================================================
# RunPod Serverless InsightFace Worker - Environment Configuration
# ==============================================================================

# RunPod Debug Mode (true for local verbose logging, false in production)
RUNPOD_DEBUG=false

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
# Cloud cluster URL (e.g. https://xxxx-xxxx.us-east-1.aws.cloud.qdrant.io:6333) or self-hosted
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
# API Key for managed Qdrant cloud authentication (leave empty for local dev if unauthenticated)
QDRANT_API_KEY=your_qdrant_api_key_here
# Target Qdrant collection name
QDRANT_COLLECTION=face_embeddings

# ------------------------------------------------------------------------------
# Image Processing & Safety Guardrails
# ------------------------------------------------------------------------------
# Maximum allowed image size in megabytes before rejecting (prevents memory exhaustion)
MAX_IMAGE_SIZE_MB=20
# HTTP download timeout in seconds for fetching R2 signed/public URLs
REQUEST_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Search & Detection Defaults
# ------------------------------------------------------------------------------
# Default maximum matches returned in similarity search operations
DEFAULT_SEARCH_LIMIT=25
# Cosine similarity score threshold (0.0 - 1.0, recommended 0.40 - 0.50 for buffalo_l)
DEFAULT_SCORE_THRESHOLD=0.45

# ------------------------------------------------------------------------------
# InsightFace Engine Configuration
# ------------------------------------------------------------------------------
# Pretrained pack name: 'buffalo_l' (high accuracy, 512-dim) or 'buffalo_s' (fast lightweight)
INSIGHTFACE_MODEL=buffalo_l
# Image detection square dimension (640 is optimal trade-off for accuracy & speed)
DETECTION_SIZE=640
